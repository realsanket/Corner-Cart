{
  "name": "CornerCart lab bench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true,
      "extensions": "containerapp,redisenterprise"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "version": "latest", "helm": "none", "minikube": "none" },
    "ghcr.io/jlaundry/devcontainer-features/azure-functions-core-tools:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "CornerCart", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-bicep",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "azurite.azurite"
      ],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
